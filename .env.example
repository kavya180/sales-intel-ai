# ------------------------------------------------------------------------------
# Sales Objection Handling Assistant - Environment Configuration Template
# ------------------------------------------------------------------------------

# Application URL
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production

# JWT & Authentication Secret (Generate a strong 64-character random string)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL with pgvector / Supabase)
# MANDATORY in production. In-memory storage is strictly prohibited in production.
DATABASE_URL=

# Supabase (Optional if direct DATABASE_URL is configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (For Sales Intelligence Report generation & text embeddings)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Razorpay Payment Gateway
# MANDATORY: In production, PAYMENT_MODE must be set to 'live' and require live credentials.
# MOCK mode is strictly rejected in production.
PAYMENT_MODE=live
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SaaS Business Configuration Defaults (Configurable)
DEFAULT_FREE_CREDITS=5
DEFAULT_TRIAL_CREDITS=25
DEFAULT_TRIAL_DAYS=30
DEFAULT_MONTHLY_CREDITS=150
DEFAULT_ONETIME_CREDITS=500
CREDIT_COST_PER_REPORT=1

# Initial Admin Account Seed (Set credentials for initial setup)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
